<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Servicio: desconocido"
            android:textSize="18sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnOpenAccessibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Activar servicio de accesibilidad"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnStartDetection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Iniciar detección (Fase 2)" />

    </LinearLayout>

    <Button
        android:id="@+id/btnToggleClicks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:text="Ver clicks: ON" />

</FrameLayout>
